<?xml version="1.0" encoding="UTF-8"?>
<UIAddon>
	<Name>TestVarDump</Name>
	<AutoStart>true</AutoStart>
	<Form href="Widgets/TestVarDump.(WidgetForm).xdb" />
	<userAddonInfo>
		<name href="AddonName.txt" />
		<description href="AddonDescription.txt" />
		<useCommonScripts>false</useCommonScripts>
	</userAddonInfo>
	<ScriptFileRefs>
		<!-- GetTableSize -->
		<Item href="/Mods/SampleCommon/SampleAddonBase.lua" />
		
		<!-- OOP -->
		<Item href="/Mods/SampleCommon/CoreScripts/ClassesImplementation.lua" />
		
		<!-- Debug -->
		<Item href="var_dump.lua" />
		<Item href="UnitTest.lua" />
	</ScriptFileRefs>
	
	<!-- Локализация Аддона -->
	<textsGroups>
		<Item>
			<groupName>template</groupName>
			<texts href="Locales/template/Locale.(UIRelatedTexts).xdb"/>
		</Item>
	</textsGroups>
</UIAddon>